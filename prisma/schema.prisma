generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Competition {
  id           String         @id @default(uuid())
  title        String
  description  String
  poster       String?
  juknis       String?
  level        String[]
  category     String
  deadline     DateTime
  price        Int
  createdAt    DateTime       @default(now())
  bankHolder   String?
  bankName     String?
  bankNumber   String?
  qris         String?
  whatsapp     String?
  announcementPoster String?
  announcementLink   String?
  requirements CompetitionRequirement[]
  timelines     CompetitionTimeline[]
  registrations Registration[]
  exams         Exam[]
}

model PaymentProof {
  id             String        @id @default(uuid())
  registrationId String        @unique
  status         PaymentStatus @default(PENDING)
  uploadedAt     DateTime      @default(now())
  fileKey        String
  registrations  Registration  @relation(fields: [registrationId], references: [id])
}

model Registration {
  id            String             @id @default(uuid())
  userId        String
  competitionId String

  leaderName    String
  members       String[]
  parentName    String

  status        RegistrationStatus @default(PENDING)
  createdAt     DateTime           @default(now())

  paymentProof  PaymentProof?
  
  creationFile     String? 

  competition   Competition        @relation(fields: [competitionId], references: [id])
  user          User               @relation(fields: [userId], references: [id])
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  password      String
  role          Role           @default(PESERTA)
  createdAt     DateTime       @default(now())
  birthDate     DateTime?
  school        String?
  registrations Registration[]
  examAttempts  ExamAttempt[]
  activityLogs  ExamActivityLog[]
}

model Exam {
  id               String        @id @default(uuid())
  competitionId    String
  title            String
  description      String?
  startAt          DateTime
  endAt            DateTime
  durationMinutes  Int
  maxAttempts      Int           @default(1)
  randomizeQuestions Boolean     @default(true)
  randomizeOptions Boolean       @default(false)
  announcementAt   DateTime?
  resultPublished  Boolean       @default(false)
  createdAt        DateTime      @default(now())

  competition      Competition   @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  questions        ExamQuestion[]
  attempts         ExamAttempt[]
}

model ExamQuestion {
  id          String       @id @default(uuid())
  examId      String
  text        String
  type        QuestionType @default(SINGLE_CHOICE)
  points      Int          @default(1)
  position    Int          @default(0)
  createdAt   DateTime     @default(now())

  exam        Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  options     ExamOption[]
  answers     ExamAnswer[]
}

model ExamOption {
  id          String       @id @default(uuid())
  questionId  String
  text        String
  isCorrect   Boolean      @default(false)
  position    Int          @default(0)

  question    ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model ExamAttempt {
  id             String          @id @default(uuid())
  userId         String
  examId         String
  startedAt      DateTime        @default(now())
  expiredAt      DateTime
  finishedAt     DateTime?
  status         ExamAttemptStatus @default(IN_PROGRESS)
  questionOrder  Json
  optionOrder    Json?
  lastQuestionId String?
  score          Float?
  passed         Boolean?
  rank           Int?

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam           Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers        ExamAnswer[]
  logs           ExamActivityLog[]

  @@index([userId, examId, status])
}

model ExamAnswer {
  id          String       @id @default(uuid())
  attemptId   String
  questionId  String
  answer      Json
  savedAt     DateTime     @default(now())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  attempt     ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question    ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}

model ExamActivityLog {
  id          String       @id @default(uuid())
  userId      String
  attemptId   String?
  event       ExamActivityEvent
  timestamp   DateTime     @default(now())
  metadata    Json?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempt     ExamAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@index([userId, attemptId, event])
}

model CompetitionRequirement {
  id            String      @id @default(uuid())
  competitionId String
  text          String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
}

model CompetitionTimeline {
  id            String      @id @default(uuid())
  competitionId String
  title         String
  endDate       DateTime
  startDate     DateTime
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Role {
  ADMIN
  PESERTA
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  ESSAY
}

enum ExamAttemptStatus {
  IN_PROGRESS
  FINISHED
  EXPIRED
}

enum ExamActivityEvent {
  LOGIN
  START_EXAM
  ANSWER_CHANGED
  AUTO_SAVE
  TAB_SWITCH
  WINDOW_BLUR
  WINDOW_FOCUS
  SUBMIT
  AUTO_SUBMIT
  RESUME_EXAM
}
